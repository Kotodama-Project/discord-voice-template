# Set these only on the trusted runtime host. Never put real values in Git.
DISCORD_BOT_TOKEN=
# Used by GPT-Live conversations and, when archive.whisperProtocol is "openai",
# by the OpenAI transcription API as well.
OPENAI_API_KEY=
# Set only when the configured local ASR endpoint requires its own credential.
KOTODAMA_LOCAL_ASR_KEY=
# Set only when archive.whisperProtocol is "openai" and the transcription key
# differs from OPENAI_API_KEY. archive.whisperApiKeyEnv names this variable.
KOTODAMA_WHISPER_KEY=
# Stable only inside one host and PID namespace. Use a different value for every
# container or host that can see the same data directory.
KOTODAMA_RUNTIME_DOMAIN=
